# Runtime configuration only. No credential values are included.
# The HELIX_ prefix keeps these separate from any other tool's credentials
# on the same machine.
HELIX_LLM_PROVIDER=anthropic
HELIX_MODEL=
HELIX_ANTHROPIC_API_KEY=
# Optional. An org-level key that is not scoped to a workspace is refused by the
# API without this header; a workspace-scoped key does not need it.
HELIX_ANTHROPIC_WORKSPACE_ID=
# Optional. Point the same Messages-API client at another host, e.g. a local
# Ollama serving a cloud model (http://127.0.0.1:11434, any non-empty key).
HELIX_ANTHROPIC_BASE_URL=
HELIX_TEST_MODEL=fake
HELIX_TIMEZONE=UTC
HELIX_MAX_STEPS=12
HELIX_TIMEOUT_SECONDS=30
# Retry schedule for mutating adapter calls (R-59). Attempt n is followed by
# BASE * 2**(n-1) + uniform(0, JITTER) seconds; three attempts, one logical key.
# 0/0 keeps the test suite instant; a real deployment wants ~0.5 / 0.1.
HELIX_BACKOFF_BASE_SECONDS=0
HELIX_BACKOFF_JITTER_SECONDS=0
# Wall-clock budget per adapter attempt; a hang is retried like any transient
# error and ends FAILED, never a fresh key. 0 = off, and off is REQUIRED with
# the in-process mock (its sqlite connection is thread-bound). Set for real
# network adapters only.
HELIX_ADAPTER_TIMEOUT_SECONDS=0
HELIX_ENABLE_TRACING=false
# Optional developer-doc tool; not a Helix runtime dependency.
CONTEXT7_API_KEY=
